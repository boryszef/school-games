// The School Games Worker: rooms for two-player games and TURN credentials (docs/plan-pvp-rooms.md).
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "school-games",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "school-games",
      "database_id": "REPLACE_WITH_DATABASE_ID",
      "migrations_dir": "migrations",
    },
  ],
  // Per IP: 20 new rooms or TURN credentials a minute.
  "ratelimits": [
    {
      "name": "SIGNALLING_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
  "vars": { "TURN_KEY_ID": "REPLACE_WITH_TURN_KEY_ID" },
  // TURN_KEY_API_TOKEN is a secret: npx wrangler secret put TURN_KEY_API_TOKEN
}
