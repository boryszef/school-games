// The School Games Worker: rooms for two-player games (docs/plan-pvp-rooms.md).
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "school-games",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "school-games",
      "database_id": "c29dc208-3877-4347-a847-a3abeca0c34a",
      "migrations_dir": "migrations",
    },
  ],
  // Per IP: 20 new rooms a minute.
  "ratelimits": [
    {
      "name": "ROOMS_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
}
