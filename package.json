{
  "name": "school-games",
  "version": "0.1.0",
  "private": true,
  "description": "Static, backend-free learning games for kids.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "deadcode": "knip",
    "serve": "python3 -m http.server 8000"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jsdom": "28.0.3",
    "@types/node": "22.20.4",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jsdom": "29.1.1",
    "knip": "6.38.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  }
}
